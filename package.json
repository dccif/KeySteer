{
  "name": "keysteer-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:sync": "node scripts/sync-doc-assets.mjs",
    "docs:dev": "pnpm docs:sync && vitepress dev docs",
    "docs:check": "vue-tsc --noEmit",
    "docs:build": "pnpm docs:sync && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:test": "node --test docs/.vitepress/simulator/*.test.ts"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "cytoscape": "^3.34.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.21",
    "debug": "^4.4.3",
    "mermaid": "^11.16.1",
    "smol-toml": "1.7.1",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  }
}
